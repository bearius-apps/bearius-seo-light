msgstr "%1$s, parte %2$d"

msgid "Show addresses"
msgstr "Mostrar direcciones"

msgid "This file does not exist."
msgstr "Este archivo no existe."

msgid "Google News preview"
msgstr "Vista previa de Google News"

msgid "Articles from the last two days in each language file, newest first. The list refreshes within five minutes of publishing."
msgstr "Artículos de los dos últimos días en el archivo de cada idioma, los más nuevos primero. La lista se actualiza en los cinco minutos siguientes a la publicación."

msgid "And %d more in the file."
msgstr "Y %d más en el archivo."

msgid "No articles from the last two days."
msgstr "No hay artículos de los dos últimos días."

msgid "What AI crawlers read"
msgstr "Lo que leen los rastreadores de IA"

msgid "Most AI crawlers download the HTML and do not run JavaScript. This is the text they get, with menus and footers counted separately."
msgstr "La mayoría de los rastreadores de IA descargan el HTML y no ejecutan JavaScript. Este es el texto que reciben; los menús y pies de página se cuentan aparte."

msgid "Home page"
msgstr "Página de inicio"

msgid "Latest post"
msgstr "Última entrada"

msgid "Address below"
msgstr "Dirección de abajo"

msgid "Address on this site"
msgstr "Dirección en este sitio"

msgid "Show"
msgstr "Mostrar"

msgid "Pick a page to fetch it now."
msgstr "Elige una página para obtenerla ahora."

msgid "Only addresses on this site can be checked."
msgstr "Solo se pueden comprobar direcciones de este sitio."

msgid "The page could not be read (HTTP %d). Some hosts block requests from the server to itself."
msgstr "No se pudo leer la página (HTTP %d). Algunos alojamientos bloquean las peticiones del servidor a sí mismo."

msgid "characters of content"
msgstr "caracteres de contenido"

msgid "of all text is content"
msgstr "de todo el texto es contenido"

